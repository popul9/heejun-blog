---
// Post pages for prefixed locales: /ko/developer/end-of-job/, /zh/foodie/osoi-brunswick-vic/, ...
import { getCollection, render } from "astro:content";
import BlogPost from "../../../layouts/BlogPost.astro";
import {
    CATEGORIES,
    SECONDARY_LOCALES,
    filterPostsByLocale,
    getLocalesBySlug,
    getPostSlug,
} from "../../../i18n/utils";

export async function getStaticPaths() {
    const paths = await Promise.all(
        SECONDARY_LOCALES.flatMap((lang) =>
            CATEGORIES.map(async (category) => {
                const all = await getCollection(category);
                const localesBySlug = getLocalesBySlug(all);

                return filterPostsByLocale(all, lang).map((entry) => {
                    const slug = getPostSlug(entry.id, lang);
                    return {
                        params: { lang, category, slug },
                        props: {
                            entry,
                            availableLocales: localesBySlug.get(slug) ?? [lang],
                        },
                    };
                });
            })
        )
    );
    return paths.flat();
}

const { entry, availableLocales } = Astro.props;
const { Content } = await render(entry);
---

<BlogPost {...entry.data} availableLocales={availableLocales}>
    <Content />
</BlogPost>
