---
// Post pages for prefixed locales: /ko/developer/end-of-job/, /zh/foodie/osoi-brunswick-vic/, ...
import { getCollection, render } from "astro:content";
import ChildPosts from "../../../components/ChildPosts.astro";
import { getChildPosts } from "../../../lib/post-groups";
import BlogPost from "../../../layouts/BlogPost.astro";
import {
    CATEGORIES,
    SECONDARY_LOCALES,
    filterPublishedPosts,
    filterPostsByLocale,
    getLocalesBySlug,
    getPostSlug,
} from "../../../i18n/utils";

export async function getStaticPaths() {
    const paths = await Promise.all(
        SECONDARY_LOCALES.flatMap((lang) =>
            CATEGORIES.map(async (category) => {
                const all = filterPublishedPosts(await getCollection(category));
                const localesBySlug = getLocalesBySlug(all);

                const localized = filterPostsByLocale(all, lang);
                return localized.map((entry) => {
                    const slug = getPostSlug(entry.id, lang);
                    return {
                        params: { lang, category, slug },
                        props: {
                            entry,
                            children: getChildPosts(entry, localized, lang),
                            availableLocales: localesBySlug.get(slug) ?? [lang],
                        },
                    };
                });
            })
        )
    );
    return paths.flat();
}

const { entry, availableLocales, children } = Astro.props;
const { Content } = await render(entry);
---

<BlogPost {...entry.data} availableLocales={availableLocales}>
    <Content />
    <ChildPosts posts={children} />
</BlogPost>
