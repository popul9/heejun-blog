---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { LOCALES, useTranslations } from "../../i18n/utils";

const t = useTranslations("th");
import wondererHero1 from "../../assets/dialogue1.webp";
import wondererHero2 from "../../assets/dialogue2.webp";
---

<!DOCTYPE html>
<html lang="th">
    <head>
        <BaseHead
            title={t("site.title")}
            description="สวัสดี นักพเนจรผู้ช่างสงสัย"
            availableLocales={LOCALES}
        />
        <style>
            main {
                width: 100%;
                max-width: 720px;
                margin: 0 auto;
                padding: 2em 1em;
                box-sizing: border-box;
                overflow-x: hidden;
            }
            .hero-gallery {
                display: flex;
                gap: 1rem;
                margin-bottom: 2.5rem;
                width: 100%;
                box-sizing: border-box;
            }
            .hero-gallery .img-wrapper {
                flex: 1 1 0;
                min-width: 0;
                max-width: 50%;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }
            .hero-gallery .img-wrapper:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            }
            .hero-gallery .img-wrapper img {
                width: 100%;
                height: auto;
                display: block;
                border-radius: 12px;
            }
            h1 {
                margin-bottom: 0.5em;
            }
            .poem {
                line-height: 1.8;
                font-size: 1.05em;
                color: rgb(var(--gray-dark));
                word-wrap: break-word;
                overflow-wrap: break-word;
                max-width: 100%;
            }
            .poem p {
                margin-bottom: 1.2em;
            }
            .signature {
                margin-top: 2em;
                font-style: italic;
                color: rgb(var(--gray));
                word-wrap: break-word;
                overflow-wrap: break-word;
                max-width: 100%;
            }
            /* Desktop: side by side */
            @media (min-width: 721px) {
                .hero-gallery .img-wrapper {
                    scroll-snap-align: unset;
                }
            }
            /* Mobile: horizontal scroll gallery */
            @media (max-width: 720px) {
                .hero-gallery {
                    overflow-x: auto;
                    scroll-snap-type: x mandatory;
                    -webkit-overflow-scrolling: touch;
                    gap: 0.75rem;
                    padding-bottom: 0.5rem;
                }
                .hero-gallery .img-wrapper {
                    flex: 0 0 85%;
                    max-width: 85%;
                    scroll-snap-align: center;
                }
                .poem {
                    font-size: 0.95em;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <div class="hero-gallery">
                <div class="img-wrapper">
                    <img
                        src={wondererHero1.src}
                        alt="อี อูฮวาน Dialogue ระยะใกล้"
                    />
                </div>
                <div class="img-wrapper">
                    <img
                        src={wondererHero2.src}
                        alt="อี อูฮวาน Dialogue ภาพรวมของนิทรรศการ"
                    />
                </div>
            </div>

            <h1>ระบบ</h1>
            <div class="poem">
                <p>
                    รอยพู่กันเล็กๆ นับไม่ถ้วน<br />
                    ทีละบรรทัด ทีละเส้น<br />
                    เชื่อมต่อกันและกันจนเกิดเป็นกระแสเดียว
                </p>
                <p>
                    กระแสของสีสร้างทิศทางขึ้นมาผ่านความสม่ำเสมอ<br />
                    จากบนลงล่าง หนึ่งเมธอด หนึ่งคลาส และหนึ่งระบบ เรียงขนานกันไป
                </p>
                <p>
                    สิ่งนี้กลายเป็นการรวมกันที่คาดเดาได้หนึ่งเดียว หรือระบบหนึ่งระบบ<br
                    />
                    เป็นรอยพู่กันใหญ่หนึ่งรอย เป็นกระแสหนึ่งสาย
                </p>
            </div>
            <p class="signature">
                - นักไอทีที่หลงใหลผลงาน <em>Dialogue</em> ของอี อูฮวาน ที่หอศิลป์แห่งชาติวิกตอเรียในเมลเบิร์น
                😆
            </p>
        </main>
        <Footer />
    </body>
</html>
