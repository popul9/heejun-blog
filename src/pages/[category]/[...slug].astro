---
// Post pages for the default locale: /developer/end-of-job/, /foodie/osoi-brunswick-vic/, ...
import { getCollection, render } from "astro:content";
import ChildPosts from "../../components/ChildPosts.astro";
import { getChildPosts } from "../../lib/post-groups";
import BlogPost from "../../layouts/BlogPost.astro";
import {
    CATEGORIES,
    DEFAULT_LOCALE,
    filterPublishedPosts,
    filterPostsByLocale,
    getLocalesBySlug,
    getPostSlug,
} from "../../i18n/utils";

export async function getStaticPaths() {
    const paths = await Promise.all(
        CATEGORIES.map(async (category) => {
            const all = filterPublishedPosts(await getCollection(category));
            const localesBySlug = getLocalesBySlug(all);

            const localized = filterPostsByLocale(all, DEFAULT_LOCALE);
            return localized.map((entry) => {
                const slug = getPostSlug(entry.id, DEFAULT_LOCALE);
                return {
                    params: { category, slug },
                    props: {
                        entry,
                        children: getChildPosts(entry, localized, DEFAULT_LOCALE),
                        availableLocales: localesBySlug.get(slug) ?? [DEFAULT_LOCALE],
                    },
                };
            });
        })
    );
    return paths.flat();
}

const { entry, availableLocales, children } = Astro.props;
const { Content } = await render(entry);
---

<BlogPost {...entry.data} availableLocales={availableLocales}>
    <Content />
    <ChildPosts posts={children} />
</BlogPost>
