---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SOCIAL_LINKS } from '../consts';
import { getLangFromUrl, getLocalizedPathname, useTranslations, type Locale } from '../i18n/utils';

// Every post collection shares the same schema, so any one of them types this.
// Standing pages (About) reuse the layout but have no publication date.
type Props = Omit<CollectionEntry<'developer'>['data'], 'pubDate'> & {
	pubDate?: Date;
	/** Languages this page is actually translated into. */
	availableLocales?: readonly Locale[];
	/** An About page is not a blog post, so it needs a different schema. */
	schemaType?: 'BlogPosting' | 'AboutPage';
	/** Visible <h1>. Defaults to `title`; standing pages override it because
	 *  their <title> also carries the site name, which an h1 should not. */
	heading?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	inProgress,
	availableLocales,
	schemaType = 'BlogPosting',
	heading = Astro.props.title,
} = Astro.props;
// Without this every translated post would declare itself as English.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonical = new URL(Astro.url.pathname, Astro.site);
// The About page is this person's canonical page, so point `url` at it in the
// reader's own language and list the profiles that are the same person.
const author = {
	'@type': 'Person',
	name: 'Heejun Moon',
	url: new URL(getLocalizedPathname('/about', lang), Astro.site).href,
	sameAs: SOCIAL_LINKS,
};

const structuredData =
	schemaType === 'AboutPage'
		? {
				'@context': 'https://schema.org',
				'@type': 'AboutPage',
				name: title,
				description: description.replace(/~~([^~]+)~~/g, '$1'),
				inLanguage: lang,
				mainEntity: author,
				url: canonical.href,
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description: description.replace(/~~([^~]+)~~/g, '$1'),
				...(pubDate && { datePublished: pubDate.toISOString() }),
				...(updatedDate && { dateModified: updatedDate.toISOString() }),
				...(heroImage && { image: new URL(heroImage.src, Astro.site).href }),
				inLanguage: lang,
				author,
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
			};
---

<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			availableLocales={availableLocales}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				aspect-ratio: 16 / 9;
				margin-bottom: 1rem;
			}
			.hero-image img {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.in-progress-notice {
				margin: 0 0 2rem;
				padding: 0.85rem 1rem;
				border-left: 4px solid rgb(var(--accent));
				background: rgb(var(--gray-light));
				border-radius: 0 8px 8px 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					/* Standing pages ship without a hero. Rendering the wrapper
					   anyway would leave a 16/9 hole above the first line. */
					heroImage && (
						<div class="hero-image">
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt=""
							/>
						</div>
					)
				}
				<div class="prose">
					<div class="title">
						<div class="date">
							{pubDate && <FormattedDate date={pubDate} />}
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on{" "}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{heading}</h1>
						<hr />
					</div>
					{inProgress && <p class="in-progress-notice"><strong>{t('post.inProgress.label')}</strong> — {t('post.inProgress.notice')}</p>}
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
