---
import {
	getLangFromUrl,
	getLocalizedPathname,
	useTranslations,
} from "../i18n/utils";
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localizedHome = getLocalizedPathname("/", lang);
const localizedWonderer = getLocalizedPathname("/wonderer", lang);
const localizedDeveloper = getLocalizedPathname("/developer", lang);
const localizedroamer = getLocalizedPathname("/roamer", lang);
const localizedMelophile = getLocalizedPathname("/melophile", lang);
const localizedFoodie = getLocalizedPathname("/foodie", lang);
const localizedAbout = getLocalizedPathname("/about", lang);
---

<header>
	<nav>
		<div class="top-row">
			<div class="brand-group">
            <h2 class="site-logo"><a href={localizedHome}>{t("site.title")}</a></h2>
            </div>
			<a href={localizedAbout} class="subtitle-link">
				{t("site.subtitle")}
			</a>
			<div class="theme-control"><ThemeToggle /></div>
		</div>

		<div class="navigation-row">
		<div class="internal-links">
			<HeaderLink href={localizedWonderer}>{t("nav.wonderer")}</HeaderLink>
			<HeaderLink href={localizedDeveloper}
				>{t("nav.developer")}
			</HeaderLink>
			<HeaderLink href={localizedroamer}>{t("nav.roamer")}</HeaderLink>
			<HeaderLink href={localizedMelophile}
				>{t("nav.melophile")}
			</HeaderLink>
			<HeaderLink href={localizedFoodie}>{t("nav.foodie")}</HeaderLink>
		</div>

        </div>

		<style>
			header {
				margin: 0;
				padding: 0.5em 1em;
				background: var(--header-background);
				border-bottom: 1px solid var(--border);
				box-shadow: 0 2px 8px rgba(var(--black), 5%);
			}

			nav {
				height: 100%;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			.top-row {
				position: relative;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.65em 1em;
			}

            .brand-group { display: flex; align-items: center; }
			h2 {
				margin: 0;
				font-size: 1em;
			}

			h2 a,
			h2 a.active {
				text-decoration: none;
			}

			.subtitle-link {
				color: rgb(var(--black));
				text-decoration: underline;
				text-decoration-color: rgba(var(--black), 25%);
				text-underline-offset: 3px;
			}

			.subtitle-link:hover {
				text-decoration-color: var(--accent);
			}

            .navigation-row { display: flex; align-items: center; justify-content: center; }
			.internal-links {
				display: flex;
				justify-content: center;
				align-items: flex-end;
				gap: 0.5em;
			}

			nav a {
				color: rgb(var(--black));
				text-decoration: none;
			}

			.internal-links a {
				padding: 0.3em 0.2em;
				font-size: 0.9em;
				border-bottom: none;
				position: relative;
			}

			.internal-links a::after {
				content: "";
				position: absolute;
				bottom: 0;
				left: 50%;
				transform: translateX(-50%);
				width: 0;
				height: 3px;
				background-color: transparent;
				transition: width 0.3s ease;
			}

			.internal-links a.active::after {
				width: 100%;
				max-width: 30px;
				background-color: var(--accent);
			}

			.internal-links a:hover::after {
				width: 100%;
				max-width: 30px;
				background-color: var(--accent);
			}

            .theme-control {
                display: flex;
                align-items: center;
                padding-left: 0.75em;
            }

			.disabled-link {
				color: #999;
				cursor: default;
				opacity: 0.6;
				text-decoration: none;
			}
			.disabled-link:hover::before {
				content: attr(data-title);
				position: absolute;
				bottom: -80%;
				left: 50%;
				transform: translateX(-50%);
				background: #333;
				color: #fff;
				padding: 4px 8px;
				border-radius: 4px;
				font-size: 12px;
				white-space: nowrap;
				z-index: 10;
			}

			.disabled-link:hover {
				opacity: 0.8;
			}
			.disabled-link:hover::after {
				display: none;
			}

            @media (min-width: 721px) {
                .top-row > .subtitle-link {
                    position: absolute;
                    left: 50%;
                    top: 50%;
                    transform: translate(-50%, -50%);
                    width: max-content;
                    margin: 0;
                    text-align: center;
                }
            }

            @media (max-width: 720px) {
                header { padding: 0.35em 1em; }
                .top-row {
                    display: grid;
                    grid-template-columns: minmax(0, 1fr) auto;
                    gap: 0.15em 1em;
                }
                .brand-group {
                    grid-area: 1 / 1;
                    min-height: 32px;
                }
                .subtitle-link {
                    grid-area: 2 / 1 / 3 / -1;
                    justify-self: center;
                    text-align: center;
                    font-size: 0.85em;
                    line-height: 1.3;
                }
                .theme-control {
                    grid-area: 1 / 2;
                    justify-self: end;
                    padding: 0;
                }
                .navigation-row { margin-top: 0.2em; }

				.internal-links {
					flex-wrap: wrap;
					gap: 0.3em;
				}
				.internal-links a {
					font-size: 0.8em;
					padding: 0.15em 0.15em;
					line-height: 1.4;
				}
			}

		</style>
	</nav>
</header>
