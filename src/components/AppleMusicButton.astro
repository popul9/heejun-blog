---
const { href, label = "Apple Music에서 듣기" } = Astro.props;
---

<a class="apple-music" href={href} target="_blank" rel="noopener noreferrer">
    <img
        src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/c3/Apple_Music_Icon_%28iOS_27%29.png/120px-Apple_Music_Icon_%28iOS_27%29.png"
        width="56"
        height="56"
        alt=""
    />
    <span>{label}</span>
</a>

<style>
    .apple-music {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        width: fit-content;
        margin: 1.5rem auto;
        font-size: 0.85em;
        font-weight: 600;
        text-decoration: none;
        color: inherit;
    }

    .apple-music img {
        margin: 0;
        box-shadow: none;
        border-radius: 13px;
        outline: 1px solid rgba(128, 128, 128, 0.35);
    }
</style>
