---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));
---

<button class="theme-toggle" type="button" aria-label={t('theme.label')} aria-pressed="false">
    <svg class="light-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="12" cy="12" r="4" fill="currentColor" stroke="none" />
        <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>
    <svg class="dark-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 6c-1-2 0-3 2-4" stroke="currentColor" stroke-width="2" />
        <path fill="currentColor" fill-rule="evenodd" d="M12 6C4 3 1 9 3 16c1 4 5 6 9 4 4 2 8 0 9-4 2-7-1-13-9-10ZM6 12l3-2 1 3Zm12 0-3-2-1 3ZM7 15l3 1 2-1 2 1 3-1-2 3H9Z" />
    </svg>
</button>

<script>
    const root = document.documentElement;
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

    function applyTheme(theme: string, animate = false) {
        root.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#140f1e' : '#ffffff');
        buttons.forEach(button => button.setAttribute('aria-pressed', String(theme === 'dark')));
        root.classList.remove('theme-entrance');
        if (animate && theme === 'dark') {
            // Restart the one-shot entrance, even after switching back quickly.
            void root.offsetWidth;
            root.classList.add('theme-entrance');
        }
    }

    applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
    buttons.forEach(button => button.addEventListener('click', () => {
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', theme); } catch {}
        applyTheme(theme, true);
    }));
    window.addEventListener('storage', event => {
        if (event.storageArea !== localStorage) return;
        if (event.key !== 'theme' && event.key !== null) return;
        applyTheme(event.key === 'theme' && event.newValue === 'dark' ? 'dark' : 'light');
    });
</script>

<style>
    .theme-toggle {
        display: grid;
        place-items: center;
        box-sizing: border-box;
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        padding: 0;
        border: 1px solid rgba(var(--black), 0.18);
        border-radius: 50%;
        background: transparent;
        color: rgb(var(--black));
        font: inherit;
        cursor: pointer;
        transition: background-color 180ms ease, border-color 180ms ease;
    }
    .theme-toggle[aria-pressed="true"] { color: #fff; }
    @media (hover: hover) {
        .theme-toggle:hover { background: rgba(var(--black), 0.08); border-color: rgba(var(--black), 0.18); }
    }
    .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .theme-toggle svg {
        grid-area: 1 / 1;
        width: 22px;
        height: 22px;
        pointer-events: none;
        transform-origin: center;
        transition: opacity 250ms ease, transform 380ms ease-in-out;
    }
    .light-icon { opacity: 1; transform: rotate(0) scale(1); }
    .dark-icon { opacity: 0; transform: rotate(30deg) scale(0.5); }
    .theme-toggle[aria-pressed="true"] .light-icon { opacity: 0; transform: rotate(-45deg) scale(0.5); }
    .theme-toggle[aria-pressed="true"] .dark-icon { opacity: 1; transform: rotate(0) scale(1); }
    @media (pointer: coarse) { .theme-toggle { flex-basis: 44px; width: 44px; height: 44px; border-color: rgba(var(--black), 0.18); } }
    @media (max-width: 720px) {
        :global(header .theme-control) .theme-toggle {
            position: relative;
            flex-basis: 30px;
            width: 30px;
            height: 30px;
            border-color: rgba(var(--black), 0.12);
        }
        :global(header .theme-control) .theme-toggle::before {
            content: '';
            position: absolute;
            inset: -7px;
            border-radius: 50%;
        }
        :global(header .theme-control) .theme-toggle svg {
            width: 18px;
            height: 18px;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .theme-toggle, .theme-toggle svg { transition: none; }
    }
</style>
