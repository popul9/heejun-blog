---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { DEFAULT_LOCALE, getLangFromUrl, getPostSlug } from '../i18n/utils';

interface Props {
    posts: {
        id: string;
        data: { title: string; description: string; heroImage?: ImageMetadata };
    }[];
}

const { posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const prefix = lang === DEFAULT_LOCALE ? '' : `/${lang}`;
const { category } = Astro.params;
---

{posts.length > 0 && (
    <ol class="child-posts">
        {posts.map((post) => (
            <li>
                <a href={`${prefix}/${category}/${getPostSlug(post.id, lang)}/`}>
                    {post.data.heroImage && (
                        <Image src={post.data.heroImage} width={720} height={405} alt="" loading="lazy" />
                    )}
                    <div class="details">
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                    </div>
                </a>
            </li>
        ))}
    </ol>
)}

<style>
    .child-posts {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: grid;
        gap: 2rem;
    }
    .child-posts li { margin: 0; padding: 0; }
    .child-posts a {
        display: grid;
        gap: 1rem;
        color: inherit;
        text-decoration: none;
    }
    .child-posts img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 12px;
    }
    .child-posts h3 { margin: 0 0 0.5rem; font-size: 1.4em; }
    .child-posts p { margin: 0; color: rgb(var(--gray-dark)); }
    .child-posts a:hover h3 { color: var(--accent); }
    .child-posts a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
</style>
