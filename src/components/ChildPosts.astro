---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { DEFAULT_LOCALE, getLangFromUrl, getPostSlug, useTranslations } from '../i18n/utils';

interface Props {
    posts: {
        id: string;
        data: { title: string; description: string; heroImage?: ImageMetadata; inProgress?: boolean };
    }[];
}

const { posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === DEFAULT_LOCALE ? '' : `/${lang}`;
const { category } = Astro.params;
---

{posts.length > 0 && (
    <ol class="child-posts">
        {posts.map((post) => (
            <li>
                {post.data.inProgress ? (
                    <div class="post-card draft">
                        {post.data.heroImage && (
                            <Image src={post.data.heroImage} width={720} height={405} alt="" loading="lazy" />
                        )}
                        <div class="details">
                            <h3>{post.data.title}</h3>
                            <span class="status">{t('post.inProgress.label')}</span>
                        </div>
                    </div>
                ) : (
                    <a class="post-card" href={`${prefix}/${category}/${getPostSlug(post.id, lang)}/`}>
                        {post.data.heroImage && (
                            <Image src={post.data.heroImage} width={720} height={405} alt="" loading="lazy" />
                        )}
                        <div class="details">
                            <div class="post-heading">
                                <h3>{post.data.title}</h3>
                                <span class="post-arrow" aria-hidden="true">→</span>
                            </div>
                            <p>{post.data.description.split(/~~([^~]+)~~/g).map((part, index) => (
                                index % 2 === 1 ? <s>{part}</s> : part
                            ))}</p>
                        </div>
                    </a>
                )}
            </li>
        ))}
    </ol>
)}

<style>
    .child-posts {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: grid;
        gap: 2rem;
    }
    .child-posts li { margin: 0; padding: 0; }
    .post-card {
        display: grid;
        gap: 1rem;
        color: inherit;
        text-decoration: none;
        border-radius: 12px;
    }
    .child-posts a:active { background-color: rgba(var(--gray-light), 0.5); }
    .child-posts img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 12px;
    }
    .post-heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 40px;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }
    .child-posts h3 { margin: 0; font-size: 1.4em; }
    .child-posts p { margin: 0; color: rgb(var(--gray-dark)); }
    .draft { color: rgb(var(--gray)); }
    .draft img { filter: grayscale(1); opacity: 0.55; }
    .status { display: inline-block; margin-top: 0.4rem; font-size: 0.9rem; }
    .post-arrow {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        box-sizing: border-box;
        border: 1px solid rgba(var(--gray), 0.5);
        border-radius: 50%;
        color: rgb(var(--gray-dark));
        font-size: 1.2rem;
        line-height: 1;
    }
    .child-posts a:hover h3,
    .child-posts a:focus-visible h3 {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-thickness: 1px;
    }
    .child-posts a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
</style>
