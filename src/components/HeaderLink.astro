---
import type { HTMLAttributes } from "astro/types";
import { LOCALES } from "../i18n/utils";

type Props = HTMLAttributes<"a">;

const isLocale = (segment: string) =>
	(LOCALES as readonly string[]).includes(segment);

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname;
const urlParts = pathname.split("/").filter(Boolean);

if (isLocale(urlParts[0])) {
	urlParts.shift();
}

const activePathname = "/" + urlParts.join("/");
const subpath = urlParts[0] || "";

// Strip lang prefix from href for comparison too
let hrefParts = String(href ?? "")
	.split("/")
	.filter(Boolean);
if (isLocale(hrefParts[0])) {
	hrefParts.shift();
}
const normalizedHref = "/" + hrefParts.join("/");

const isActive =
	normalizedHref === activePathname ||
	normalizedHref === activePathname + "/" ||
	normalizedHref === "/" + subpath;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
